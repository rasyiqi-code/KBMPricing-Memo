{
  "name": "kbm-pricing-calculator",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "vite build && npx cap sync android",
    "android:build": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "electron:dev": "vite build && electron electron/main.cjs",
    "electron:build:win": "vite build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.penerbitkbm.calculator",
    "productName": "KBM Pricing Calculator",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "KBM Pricing Calculator",
      "uninstallDisplayName": "KBM Pricing Calculator"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/clipboard": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/share": "^6.0.2",
    "lucide-vue-next": "^0.460.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.3"
  }
}
